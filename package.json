{
  "name": "fantazone",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "src/app",
    "src/domain",
    "src/github",
    "src/jobs"
  ],
  "scripts": {
    "app:web": "npm run web --workspace=fantazone-app",
    "app:start": "npm run start --workspace=fantazone-app",
    "typecheck": "npm run typecheck --workspace=fantazone-app",
    "test": "npm run test:github",
    "test:github": "tsx --test tests/github/*.test.ts"
  },
  "devDependencies": {
    "tsx": "^4.20.5"
  }
}
