{
  "name": "fantazone",
  "version": "0.3.4",
  "private": true,
  "workspaces": [
    "src/app",
    "src/domain",
    "src/github",
    "src/jobs"
  ],
  "scripts": {
    "app:web": "npm run web --workspace=fantazone-app",
    "app:start": "npm run start --workspace=fantazone-app",
    "typecheck": "npm run typecheck --workspace=fantazone-app && npm run typecheck --workspace=@fantazone/jobs",
    "test": "npm run test:github && npm run test:domain && npm run test:app && npm run test:jobs && npm run test:migration",
    "test:github": "tsx --test tests/github/*.test.ts",
    "test:domain": "tsx --test tests/domain/*.test.ts",
    "test:app": "tsx --test tests/app/*.test.ts",
    "test:jobs": "tsx --test tests/jobs/*.test.ts",
    "test:migration": "node --test tests/migration/*.test.mjs",
    "test:integration:github": "tsx --test tests/integration/githubReal.test.ts",
    "test:e2e": "playwright test",
    "build:offline-packs": "node scripts/build-offline-serie-a-packs.mjs",
    "migrate:azure": "node scripts/migration/migrate-azure-to-github.mjs"
  },
  "devDependencies": {
    "@azure/storage-blob": "^12.33.0",
    "@playwright/test": "^1.62.1",
    "http-server": "^14.1.1",
    "tsx": "^4.20.5"
  }
}
