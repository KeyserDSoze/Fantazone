{
  "expo": {
    "name": "FantaZone",
    "slug": "fantazone",
    "version": "0.1.0",
    "platforms": ["ios", "android", "web"],
    "userInterfaceStyle": "automatic",
    "orientation": "portrait",
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": ["expo-font", "expo-status-bar", "expo-secure-store"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.keyserdsoze.fantazone"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
