{
  "expo": {
    "name": "fanta.plus",
    "slug": "fantazone",
    "version": "0.1.0",
    "platforms": ["ios", "android", "web"],
    "userInterfaceStyle": "automatic",
    "orientation": "portrait",
    "scheme": "fantaplus",
    "experiments": {
      "tsconfigPaths": true,
      "baseUrl": "/"
    },
    "plugins": ["expo-font", "expo-status-bar", "expo-secure-store"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.keyserdsoze.fantaplus"
    },
    "android": {
      "package": "com.keyserdsoze.fantazone"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "fanta.plus",
      "shortName": "fanta.plus",
      "themeColor": "#ffd100",
      "backgroundColor": "#ffffff"
    }
  }
}
